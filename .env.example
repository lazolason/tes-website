# Environment Variables
# Copy this file to .env.local and fill in the values

# Email Configuration (for contact form)
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Site URL (for sitemap and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://mexelenergysustain.com

# Google Analytics 4 (optional)
# Set this to your GA4 measurement ID to enable event tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google reCAPTCHA v2 (optional)
# Public site key for the contact page widget.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-public-site-key
# Local Next.js dev route secret. Production PHP reads MEXEL_RECAPTCHA_SECRET
# from the hosting environment.
RECAPTCHA_SECRET_KEY=your-secret-key
